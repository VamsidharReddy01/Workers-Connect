# ==============================
# DJANGO CORE
# ==============================

# SECURITY: Generate a real secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# Set to True ONLY for local development. Never True in production.
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================
# DATABASE
# ==============================

DB_NAME=workers_db
DB_USER=workers_user
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# ==============================
# EMAIL CONFIGURATION
# ==============================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SECURITY: Use a Gmail App Password — never your real password.
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_USE_APP_PASSWORD

DEFAULT_FROM_EMAIL=Workers Bridge <your-email@gmail.com>
EMAIL_TIMEOUT=15

# ==============================
# CORS (Production)
# ==============================

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================
# SIGNUP OTP CONFIGURATION
# ==============================

SIGNUP_OTP_EXPIRY_SECONDS=600
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_OTP_MAX_VERIFY_ATTEMPTS=5

# ==============================
# FIREBASE (Optional)
# ==============================

# Path to Firebase service account JSON key file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
